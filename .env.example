# Example environment variables for MyLessonPlanner
# Use this file as a template and create a .env file in the same directory.

# Base container image (set by CI/Deployment or use directly in a Dockerfile)
ENV_IMAGE_NAME=fastapi_react_mongo_shadcn_base_image_cloud_arm:release-11112025-1

# Example ports and runtime values (adjust for your setup)
APP_PORT=3000
API_URL=http://localhost:8000

# Example keys (do not store real long-lived keys in the repository)
# API_KEY=your_api_key_here

# Database and app settings (examples)
# - MONGO_URL: MongoDB connection string
# - DB_NAME: name of the database to use
# - CORS_ORIGINS: CORS allowed origin(s). Use '*' for development only.
# - SECRET_KEY: Application secret used for session signing / JWT tokens.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"
CORS_ORIGINS="*"
# NOTE: For production, rotate this and store securely (secrets manager / CI secret)
SECRET_KEY="lesson-planner-secret-key-2025-rave-jhon-bautista"
